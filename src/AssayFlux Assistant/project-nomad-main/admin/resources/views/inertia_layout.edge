<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/assayflux-mark.svg">
  
  
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">

  <title inertia>AssayFlux Assistant</title>

  <script>
    (function() {
      try {
        var theme = localStorage.getItem('nomad:theme');
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch(e) {}
    })();
  </script>

  @stack('dumper')
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>

<body class="min-h-screen w-screen font-sans">
  @inertia()
</body>

</html>
