# ============================================================
# ASSAYFLUX — UNIVERSAL LANGUAGE SHOWCASE
# ============================================================
#
# Purpose:
#   Demonstrate the core AssayFlux language in one file.
#
# Sections:
#   01. Variables and constants
#   02. Data literals
#   03. Arithmetic operators
#   04. Comparison operators
#   05. Logical operators
#   06. Expression precedence
#   07. Conditional statements
#   08. Nested conditionals
#   09. Basic functions
#   10. Functions with multiple parameters
#   11. Return values
#   12. Recursive functions
#   13. Count-controlled loops
#   14. Condition-controlled loops
#   15. Loop control
#   16. Nested loops
#   17. Variable updates
#   18. Scientific calculations
#   19. String operations
#   20. Boolean expressions
#   21. Function-based calculations
#   22. Reusable calculations
#   23. Practical laboratory example
#   24. Program summary
#
# Notes:
#   - Comments begin with #.
#   - Indentation uses four spaces per level.
#   - Blocks use indentation and explicit end statements.
#   - Block headers follow the syntax of the inspected grammar.
#   - Import and input examples are documented separately below.
#
# ============================================================


# ============================================================
# 01. VARIABLES AND CONSTANTS
# ============================================================

show "==================================================="
show "01. VARIABLES AND CONSTANTS"
show "==================================================="

app_name = "AssayFlux"
app_version = "1.0.0"
language_name = "AssayFlux Language"

constant MAX_SCORE = 100
constant MIN_SCORE = 0
constant PASS_MARK = 50

show app_name
show app_version
show language_name

show MAX_SCORE
show MIN_SCORE
show PASS_MARK


# ============================================================
# 02. DATA LITERALS
# ============================================================

show "==================================================="
show "02. DATA LITERALS"
show "==================================================="

integer_value = 42
decimal_value = 3.14159
text_value = "Hello, AssayFlux!"
true_value = true
false_value = false

show integer_value
show decimal_value
show text_value
show true_value
show false_value

negative_value = -25
positive_value = +25

show negative_value
show positive_value


# ============================================================
# 03. ARITHMETIC OPERATORS
# ============================================================

show "==================================================="
show "03. ARITHMETIC OPERATORS"
show "==================================================="

number_a = 20
number_b = 6

show "Addition"
show number_a + number_b

show "Subtraction"
show number_a - number_b

show "Multiplication"
show number_a * number_b

show "Division"
show number_a / number_b

show "Remainder"
show number_a % number_b

show "Exponentiation, if enabled by the parser"
show number_a ** 2

show "Floor division, if enabled by the parser"
show number_a // number_b


# ============================================================
# 04. COMPARISON OPERATORS
# ============================================================

show "==================================================="
show "04. COMPARISON OPERATORS"
show "==================================================="

left_value = 10
right_value = 20

show left_value == right_value
show left_value != right_value

show left_value < right_value
show left_value > right_value

show left_value <= right_value
show left_value >= right_value


# ============================================================
# 05. LOGICAL OPERATORS
# ============================================================

show "==================================================="
show "05. LOGICAL OPERATORS"
show "==================================================="

show true and true
show true and false

show true or false
show false or false

show not true
show not false

logical_a = true
logical_b = false

show logical_a and logical_b
show logical_a or logical_b
show not logical_a


# ============================================================
# 06. EXPRESSION PRECEDENCE
# ============================================================

show "==================================================="
show "06. EXPRESSION PRECEDENCE"
show "==================================================="

precedence_a = 2 + 3 * 4
precedence_b = (2 + 3) * 4

show precedence_a
show precedence_b

precedence_c = 20 - 5 - 3
precedence_d = 20 / 5 * 2

show precedence_c
show precedence_d

precedence_e = 10 + 5 * 2 - 3
show precedence_e


# ============================================================
# 07. CONDITIONAL STATEMENTS
# ============================================================

show "==================================================="
show "07. CONDITIONAL STATEMENTS"
show "==================================================="

score = 85

if score >= 90:
    show "Excellent performance"
otherwise score >= 75:
    show "Very good performance"
otherwise score >= 50:
    show "Satisfactory performance"
else:
    show "Improvement required"
end


# ============================================================
# 08. NESTED CONDITIONALS
# ============================================================

show "==================================================="
show "08. NESTED CONDITIONALS"
show "==================================================="

is_registered = true
has_permission = true

if is_registered:
    show "Registration verified"

    if has_permission:
        show "Access granted"
    else:
        show "Access denied"
    end

else:
    show "Registration required"
end


# ============================================================
# 09. BASIC FUNCTIONS
# ============================================================

show "==================================================="
show "09. BASIC FUNCTIONS"
show "==================================================="

f.greet():
    return "Welcome to AssayFlux"
end

greeting = greet()
show greeting


# ============================================================
# 10. FUNCTIONS WITH MULTIPLE PARAMETERS
# ============================================================

show "==================================================="
show "10. MULTI-PARAMETER FUNCTIONS"
show "==================================================="

f.add(a, b):
    return a + b
end

f.subtract(a, b):
    return a - b
end

f.multiply(a, b):
    return a * b
end

f.divide(a, b):
    return a / b
end

addition_result = add(12, 8)
subtraction_result = subtract(12, 8)
multiplication_result = multiply(12, 8)
division_result = divide(12, 8)

show addition_result
show subtraction_result
show multiplication_result
show division_result


# ============================================================
# 11. FUNCTIONS WITH RETURN VALUES
# ============================================================

show "==================================================="
show "11. FUNCTION RETURN VALUES"
show "==================================================="

f.square(value):
    return value * value
end

f.cube(value):
    return value * value * value
end

f.calculate_average(total, count):
    return total / count
end

square_result = square(5)
cube_result = cube(3)
average_result = calculate_average(150, 3)

show square_result
show cube_result
show average_result


# ============================================================
# 12. RECURSIVE FUNCTIONS
# ============================================================

show "==================================================="
show "12. RECURSIVE FUNCTIONS"
show "==================================================="

f.factorial(number):
    if number <= 1:
        return 1
    else:
        return number * factorial(number - 1)
    end
end

factorial_result = factorial(5)
show factorial_result


# ============================================================
# 13. COUNT-CONTROLLED LOOPS
# ============================================================

show "==================================================="
show "13. COUNT-CONTROLLED LOOPS"
show "==================================================="

repeat count 3:
    show "Count-controlled iteration"
end

repeat count 5:
    show "Processing a repeated task"
end


# ============================================================
# 14. CONDITION-CONTROLLED LOOPS
# ============================================================

show "==================================================="
show "14. CONDITION-CONTROLLED LOOPS"
show "==================================================="

counter = 0

repeat while counter < 5:
    show counter
    counter = counter + 1
end

show "Condition-controlled loop completed"


# ============================================================
# 15. LOOP CONTROL: SKIP
# ============================================================

show "==================================================="
show "15. LOOP CONTROL — SKIP"
show "==================================================="

counter = 0

repeat while counter < 5:
    counter = counter + 1

    if counter == 3:
        skip
    end

    show counter
end


# ============================================================
# 16. LOOP CONTROL: STOP
# ============================================================

show "==================================================="
show "16. LOOP CONTROL — STOP"
show "==================================================="

counter = 0

repeat forever:
    counter = counter + 1

    if counter >= 4:
        stop
    end

    show counter
end

show "Loop terminated"


# ============================================================
# 17. NESTED LOOPS
# ============================================================

show "==================================================="
show "17. NESTED LOOPS"
show "==================================================="

outer_counter = 0

repeat while outer_counter < 3:
    show "Outer iteration"

    inner_counter = 0

    repeat while inner_counter < 2:
        show inner_counter
        inner_counter = inner_counter + 1
    end

    outer_counter = outer_counter + 1
end


# ============================================================
# 18. VARIABLE UPDATES
# ============================================================

show "==================================================="
show "18. VARIABLE UPDATES"
show "==================================================="

value = 10
show value

value = value + 5
show value

value = value - 3
show value

value = value * 2
show value

value = value / 4
show value


# ============================================================
# 19. STRING OPERATIONS
# ============================================================

show "==================================================="
show "19. STRING OPERATIONS"
show "==================================================="

first_word = "Assay"
second_word = "Flux"

show first_word
show second_word

combined_text = first_word + second_word
show combined_text

welcome_text = "Welcome to " + app_name
show welcome_text

laboratory_name = "Clinical Biochemistry Laboratory"
show laboratory_name


# ============================================================
# 20. BOOLEAN EXPRESSIONS
# ============================================================

show "==================================================="
show "20. BOOLEAN EXPRESSIONS"
show "==================================================="

quality_control_passed = true
instrument_ready = true
sample_available = false

if quality_control_passed and instrument_ready:
    show "System checks passed"
else:
    show "System checks failed"
end

if sample_available:
    show "Sample is available"
else:
    show "Sample is unavailable"
end


# ============================================================
# 21. FUNCTION-BASED CALCULATIONS
# ============================================================

show "==================================================="
show "21. FUNCTION-BASED CALCULATIONS"
show "==================================================="

f.percentage(part, whole):
    return part / whole * 100
end

f.difference(value_a, value_b):
    return value_a - value_b
end

f.mean_of_two(value_a, value_b):
    return (value_a + value_b) / 2
end

percentage_result = percentage(25, 100)
difference_result = difference(80, 65)
mean_result = mean_of_two(20, 40)

show percentage_result
show difference_result
show mean_result


# ============================================================
# 22. REUSABLE CALCULATIONS
# ============================================================

show "==================================================="
show "22. REUSABLE CALCULATIONS"
show "==================================================="

f.is_passing(mark):
    if mark >= PASS_MARK:
        return true
    else:
        return false
    end
end

f.classify_mark(mark):
    if mark >= 90:
        return "Excellent"
    otherwise mark >= 75:
        return "Very good"
    otherwise mark >= PASS_MARK:
        return "Pass"
    else:
        return "Fail"
    end
end

student_mark = 82
pass_status = is_passing(student_mark)
mark_category = classify_mark(student_mark)

show pass_status
show mark_category


# ============================================================
# 23. PRACTICAL LABORATORY CALCULATION
# ============================================================

show "==================================================="
show "23. PRACTICAL LABORATORY CALCULATION"
show "==================================================="

# Illustrative absorbance measurements.
# These are demonstration values, not clinical reference limits.

blank_absorbance = 0.020
standard_absorbance = 0.500
sample_absorbance = 0.250

standard_concentration = 100

corrected_standard = standard_absorbance - blank_absorbance
corrected_sample = sample_absorbance - blank_absorbance

f.calculate_concentration(sample_signal, standard_signal, standard_value):
    return sample_signal / standard_signal * standard_value
end

calculated_concentration = calculate_concentration(
    corrected_sample,
    corrected_standard,
    standard_concentration
)

show "Blank absorbance:"
show blank_absorbance

show "Corrected standard signal:"
show corrected_standard

show "Corrected sample signal:"
show corrected_sample

show "Calculated concentration:"
show calculated_concentration


# ============================================================
# 24. FINAL SUMMARY
# ============================================================

show "==================================================="
show "ASSAYFLUX UNIVERSAL EXAMPLE COMPLETED"
show "==================================================="

show "Language:"
show language_name

show "Version:"
show app_version

show "Arithmetic test:"
show addition_result

show "Function test:"
show square_result

show "Recursion test:"
show factorial_result

show "Loop test:"
show counter

show "Laboratory calculation:"
show calculated_concentration

show "All enabled demonstration sections have finished."